{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "paid-access",
  "publisher": "did:plc:neov22wblqftd3653r6cl2gl", // @masonjames.com (handle verified 2026-09-29)
  "license": "GPL-2.0-or-later",
  "author": {
    "name": "Mason James",
    "url": "https://masonjames.com/plugins/paid-access/"
  },
  "security": {
    "email": "hi@masonjames.com",
    "url": "https://masonjames.com/.well-known/security.txt"
  },
  "name": "Paid Access",
  "description": "Stripe memberships and x402 paid reads for EmDash. Free GPL beta; requires the npm Astro companion and theme integration.",
  "keywords": [
    "paywall",
    "memberships",
    "stripe",
    "x402",
    "ai-agents"
  ],
  "repo": "https://github.com/masonjames/emdash-paid-access",
  "sections": {
    "description": "Paid Access connects Stripe memberships for people and x402 paid reads for AI agents. Use either module or both; each starts off. Configure entry and taxonomy rules, manage plans, and review agent payment receipts in EmDash. The complete plugin is free under GPL-2.0-or-later, with no license gating and no cut of your payments. Setup, migration, hosting, and support are separate services from Mason James. Based on Restrict With Stripe for EmDash by Stranger Studios.",
    "installation": "The npm beta is pending release acceptance; the EmDash registry remains unpublished. Requires EmDash 1.2 and a server-rendered Astro site on Node. After npm publication, install emdash-paid-access@0.1.0-beta.1, register its core descriptor and paidAccessAstro integration, and gate protected bodies with PaidContent. Source-build instructions are available in the README. A future registry installation supplies only the core admin and storage: it replaces the npm descriptor in plugins while still requiring the npm Astro companion and theme integration. Register the core once. Follow the matching version's installation and hosting guides; registry core plus companion requires separate host acceptance.",
    "faq": "**Does this replace Stripe or charge a platform fee?** No. Creators receive their Stripe memberships and agent payments in their own accounts/wallets; provider fees may apply.\n\n**Which agent payments work in this beta?** Origin x402. Gateway verification, subscriber tokens, and passes are not available. Development uses Base Sepolia; mainnet needs an explicitly compatible facilitator.\n\n**Can I keep Restrict With Stripe?** Use delegation during migration and retain the existing member UI. Automatic customer/session migration and free-member entitlements are not included.",
    "security": { "file": "./SECURITY.md" }
  },
  "release": {
    "requires": {
      "env:emdash": "^1.2.0"
    },
    "artifacts": {
      "icon": { "file": "./icon.png" },
      "banner": { "file": "./assets/listing/banner.png", "lang": "en" }
    }
  },
  "capabilities": [
    "content:read",
    "taxonomies:read",
    "network:request",
    "email:send"
  ],
  "allowedHosts": [
    "api.stripe.com"
  ],
  "storage": {
    "restrictions": {
      "indexes": [
        "contentId",
        "collectionSlug",
        "slug"
      ]
    },
    "taxonomy_restrictions": {
      "indexes": [
        "taxonomyName",
        "termId"
      ]
    },
    "customers": {
      "indexes": [
        "email"
      ]
    },
    "auth_tokens": {
      "indexes": [
        "email",
        "expiresAt"
      ]
    },
    "sessions": {
      "indexes": [
        "email",
        "expiresAt"
      ]
    },
    "receipts": {
      "indexes": [
        "entryId",
        "network",
        "payer",
        "transaction",
        "createdAt"
      ]
    }
  },
  "admin": {
    "pages": [
      {
        "path": "/settings",
        "label": "Paid Access Settings",
        "icon": "settings"
      },
      {
        "path": "/rules",
        "label": "Paid Access Rules"
      },
      {
        "path": "/receipts",
        "label": "Paid Access Receipts"
      }
    ],
    "widgets": [
      {
        "id": "overview",
        "title": "Paid Access",
        "size": "half"
      }
    ],
    "editorPanels": [
      {
        "id": "paid-access",
        "title": "Paid access",
        "route": "editor/paid-access"
      }
    ],
    "settingsSchema": {
      "stripeSecretKey": {
        "type": "secret",
        "label": "Stripe secret key"
      }
    }
  }
}
