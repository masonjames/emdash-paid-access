---
// Copyright 2026 Mason James.
// SPDX-License-Identifier: GPL-2.0-or-later
import type { HumanDecision } from "emdash-paid-access/astro/runtime";
import Pricing from "./Pricing.astro";
interface Props { decision: HumanDecision; redirect: string; collection: string; slug: string }
const { decision, redirect, collection, slug } = Astro.props;
const { accountPath, agentRoutePrefix } = Astro.locals.paidAccess.options;
const messages: Record<string, string> = {
	"link-sent": "Check your email for a sign-in link. It expires in 15 minutes.",
	"link-error": "We couldn't send a link just now. Wait a minute and try again.",
	"check-email": "Thanks for subscribing. Check your email for a link to finish signing in.",
	"checkout-error": "Checkout didn't start. Please try again.",
	"link-invalid": "That sign-in link has expired or was already used. Request a new one.",
};
const state = Astro.url.searchParams.get("phb") ?? "";
const message = messages[state];
const agentUrl = `${agentRoutePrefix}/${encodeURIComponent(collection)}/${encodeURIComponent(slug)}.md`;
---
<section class="phb-paywall" data-phb-state="paywall">
	<h2>This post is for members</h2>
	{message && <p role="status" data-phb-message={state}>{message}</p>}
	<Pricing redirect={redirect} />
	<form method="post" action={`${accountPath}/sign-in`}>
		<p>Already a member? Get a sign-in link</p>
		<input type="hidden" name="redirect" value={redirect} />
		<label>Email <input type="email" name="email" autocomplete="email" required /></label>
		<button type="submit">Email me a link</button>
	</form>
	{decision.agentsSold === true && <p class="phb-agent-note">AI agents can buy this post at <a href={agentUrl}>{agentUrl}</a>.</p>}
</section>
<style>
.phb-paywall { color: #202124; background: #fff; padding: 1rem; border-radius: var(--phb-radius, .5rem); }
form, label { display: grid; gap: .75rem; }
input, button { font: inherit; padding: .65rem; border: 1px solid var(--phb-border, #767676); border-radius: var(--phb-radius, .5rem); }
input { color: #202124; background: #fff; }
button { background: var(--phb-accent, #174ea6); color: #fff; cursor: pointer; }
a { color: var(--phb-accent, #174ea6); overflow-wrap: anywhere; }
:focus-visible { outline: 3px solid var(--phb-accent, #174ea6); outline-offset: 3px; }
.phb-agent-note { color: var(--phb-muted, #525252); }
@media (prefers-color-scheme: dark) {
	.phb-paywall { color: #f5f5f5; background: #181818; }
	.phb-agent-note { color: var(--phb-muted, #c5c5c5); }
	a { color: var(--phb-accent, #a8c7fa); }
	:focus-visible { outline-color: var(--phb-accent, #a8c7fa); }
}
</style>
