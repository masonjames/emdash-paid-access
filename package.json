{
  "name": "emdash-paid-access",
  "version": "0.1.0-beta.2",
  "license": "GPL-2.0-or-later",
  "copyright": "Copyright 2026 Stranger Studios; modified by Mason James 2026-09-23",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "emdash-plugin build && tsdown",
    "validate": "emdash-plugin validate",
    "bundle": "emdash-plugin bundle",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "release:check": "pnpm peers check && pnpm typecheck && pnpm build && pnpm test && pnpm test:sandbox && pnpm validate && pnpm bundle && node scripts/check-package.mjs",
    "prepack": "pnpm build && node scripts/prepare-package.mjs",
    "prepublishOnly": "pnpm release:check"
  },
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./sandbox": "./dist/plugin.mjs",
    "./astro": {
      "types": "./dist/astro/index.d.mts",
      "import": "./dist/astro/index.mjs",
      "default": "./dist/astro/index.mjs"
    },
    "./astro/middleware": {
      "types": "./dist/astro/middleware.d.mts",
      "import": "./dist/astro/middleware.mjs",
      "default": "./dist/astro/middleware.mjs"
    },
    "./astro/runtime": {
      "types": "./dist/astro/runtime.d.mts",
      "import": "./dist/astro/runtime.mjs",
      "default": "./dist/astro/runtime.mjs"
    },
    "./astro/routes/agent-entry": {
      "types": "./dist/astro/routes/agent-entry.d.mts",
      "import": "./dist/astro/routes/agent-entry.mjs",
      "default": "./dist/astro/routes/agent-entry.mjs"
    },
    "./astro/routes/offers": {
      "types": "./dist/astro/routes/offers.d.mts",
      "import": "./dist/astro/routes/offers.mjs",
      "default": "./dist/astro/routes/offers.mjs"
    },
    "./astro/routes/account": {
      "types": "./dist/astro/routes/account.d.mts",
      "import": "./dist/astro/routes/account.mjs",
      "default": "./dist/astro/routes/account.mjs"
    },
    "./components/*": "./src/components/*"
  },
  "peerDependencies": {
    "emdash": "^1.2.0",
    "astro": "^6.1.3 || ^7.3.5",
    "@emdash-cms/x402": "^1.2.0"
  },
  "devDependencies": {
    "@emdash-cms/blocks": "1.2.0",
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/x402": "1.2.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.27.0",
    "astro": "7.3.5",
    "emdash": "1.2.0",
    "tsdown": "0.22.0",
    "typescript": "5.9.3",
    "viem": "2.56.8",
    "vitest": "^4.1.9",
    "@emdash-cms/plugin-test": "0.2.8",
    "vite": "^8.0.0",
    "zod": "4.5.4"
  },
  "files": [
    "dist",
    "!dist/*.tar.gz",
    "emdash-plugin.jsonc",
    "NOTICE.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "src",
    "tests",
    "tsconfig.json",
    "tsdown.config.ts",
    "vitest.config.ts",
    "icon.png",
    "assets/listing",
    "pnpm-workspace.yaml",
    "vitest.sandbox.config.ts",
    "scripts",
    "patches",
    "docs/README.md",
    "docs/guides",
    "docs/reference",
    "docs/releases/0.1.0-beta.1.md",
    "docs/releases/0.1.0-beta.2.md"
  ],
  "packageManager": "pnpm@12.10.1",
  "description": "Stripe memberships and x402 paid reads for EmDash, with server-rendered access control and an Astro companion.",
  "author": {
    "name": "Mason James",
    "url": "https://masonjames.com"
  },
  "contributors": [
    {
      "name": "Stranger Studios",
      "url": "https://www.strangerstudios.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masonjames/emdash-paid-access.git"
  },
  "homepage": "https://masonjames.com/plugins/paid-access/",
  "bugs": {
    "url": "https://github.com/masonjames/emdash-paid-access/issues"
  },
  "keywords": [
    "emdash",
    "astro",
    "paywall",
    "memberships",
    "stripe",
    "x402",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
